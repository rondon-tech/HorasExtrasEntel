# Environment variables for Horas Extras Entel
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# PostgreSQL connection string (Neon.tech serverless)
# Generate at https://console.neon.tech
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Port for the Express backend (local dev only; Vercel ignores this)
PORT=3001

# JWT secret: generate with `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
JWT_SECRET="replace-with-a-strong-random-secret-of-at-least-64-bytes"

# Admin credentials for the single-user MVP login.
# Rotate immediately; replace with hashed users table in a later phase.
ADMIN_USER="replace-with-admin-username"
ADMIN_PASSWORD="replace-with-strong-admin-password"

# Frontend URL allowed by CORS (production domain), e.g. https://horas-extras.vercel.app
FRONTEND_URL="https://your-production-frontend.vercel.app"

# Node environment: development | production
NODE_ENV="development"

# Toggle verbose logging (optional)
LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# Database failover — second Neon.tech project (optional, enables auto-failover)
# Create at https://console.neon.tech → New Project → "horas-extras-fallback"
# ---------------------------------------------------------------------------
# DATABASE_URL_FALLBACK="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ---------------------------------------------------------------------------
# Cloudflare R2 — backup storage
# Used by `npm run backup` and `npm run restore` (GitHub Actions)
# ---------------------------------------------------------------------------
# R2_ENDPOINT="https://YOUR_ACCOUNT.r2.cloudflarestorage.com"
# R2_ACCESS_KEY_ID="your-access-key-id"
# R2_SECRET_ACCESS_KEY="your-secret-access-key"
# R2_BUCKET="backups-app-hhee-entel"
# AES-256 backup encryption key (64 hex chars = 32 bytes). REQUIRED for
# backup/restore/drill. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BACKUP_ENCRYPTION_KEY="..."
# Optional: PGSSLMODE=disable only for local Postgres without TLS. Never in production.
# PGSSLMODE=""

# ---------------------------------------------------------------------------
# Agent system — LLM (4 gateways in cascade + per-agent model assignment)
#
# Benchmark 2026-08-29 (tools / strict JSON / vision OCR):
#   Groq (primary):      qwen3.8-27b 0.8s tools, 0.5s JSON   <- chat + JSON
#   OpenRouter (2nd):    minimax-m3:free 3.4s vision OCR     <- vision
#   Ollama Cloud (3rd):  gpt-oss:120b 2.1s tools, gemma4:31b 0.9s vision (2da opcion)
#                        (solo gpt-oss/gemma4/nemotron accesibles en free; GLM/qwen/kimi/mistral 402)
#   TokenRouter (backup): glm-5.3-free (razonamiento profundo; lento ~60s)
#   Gemini (5th active):  gemini-3.6-flash 8.2s tools, 2.7s vision OCR, JSON OK con max_tokens>=2000 (thinking consume budget)
#   Cerebras (dormant):   cuenta sin creditos (402 payment_required). Catalogo actual:
#                         gpt-oss-120b, gemma-4-31b (vision). Activar cuando haya creditos:
# LLM_CEREBRAS_BASE_URL="https://api.cerebras.ai/v1"
# LLM_CEREBRAS_API_KEY="csk-..."
# LLM_CEREBRAS_MODELS="gpt-oss-120b,gemma-4-31b"
# LLM_GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# LLM_GEMINI_API_KEY="AQ.Ab8..."
# LLM_GEMINI_MODELS="gemini-3.6-flash,gemini-3.5-flash"
# Model spec: 'model' = primary; 'secondary:'/'ollama:'/'gemini:'/'cerebras:'/'backup:model' = otros tiers.
# ---------------------------------------------------------------------------
# LLM_API_KEY="gsk_..."            (Groq)
# LLM_BASE_URL="https://api.groq.com/openai/v1"
# LLM_MODEL="qwen/qwen3.8-27b"
# LLM_FALLBACK_MODELS="openai/gpt-oss-120b,openai/gpt-oss-20b"
# LLM_SECONDARY_BASE_URL="https://openrouter.ai/api/v1"
# LLM_SECONDARY_API_KEY="sk-or-..."
# LLM_SECONDARY_MODELS="minimax/minimax-m3:free,nvidia/nemotron-3-super-120b-a12b:free"
# LLM_OLLAMA_BASE_URL="https://ollama.com/v1"
# LLM_OLLAMA_API_KEY="bb15..."
# LLM_OLLAMA_MODELS="gpt-oss:120b,gpt-oss:20b"
# LLM_BACKUP_BASE_URL="https://api.tokenrouter.com/v1"
# LLM_BACKUP_API_KEY="sk-..."
# LLM_BACKUP_MODELS="z-ai/glm-5.3-free,qwen/qwen3.8-max-free"
# LLM_JSON_MODEL="qwen/qwen3.8-27b"
# LLM_VISION_MODEL="secondary:minimax/minimax-m3:free"
# LLM_REPORT_MODEL="ollama:gpt-oss:120b"
# LLM_MODEL_TIMEOUT_MS="45000"
# Daily token budget per user (input+output, all agents combined)
# AGENT_DAILY_TOKEN_BUDGET="200000"
# Monthly extra-hours cap used by the anomaly agent for flagging (hours)
# AGENT_MAX_MONTHLY_EXTRA_HOURS="60"

# Sentry error tracking (optional). Leave empty to disable.
# SENTRY_DSN="https://your-key@oXXXX.ingest.sentry.io/XXXX"
# Ephemeral database for the monthly A5 restore drill (GitHub Actions secret).
# Create a throwaway Neon project; data is wiped and rolled back on every run.
# DRILL_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
