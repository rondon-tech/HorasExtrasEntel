# Environment variables for Horas Extras Entel
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# PostgreSQL connection string (Neon.tech serverless)
# Generate at https://console.neon.tech
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Port for the Express backend (local dev only; Vercel ignores this)
PORT=3001

# JWT secret: generate with `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
JWT_SECRET="replace-with-a-strong-random-secret-of-at-least-64-bytes"

# Admin credentials for the single-user MVP login.
# Rotate immediately; replace with hashed users table in a later phase.
ADMIN_USER="replace-with-admin-username"
ADMIN_PASSWORD="replace-with-strong-admin-password"

# Frontend URL allowed by CORS (production domain), e.g. https://horas-extras.vercel.app
FRONTEND_URL="https://your-production-frontend.vercel.app"

# Node environment: development | production
NODE_ENV="development"

# Toggle verbose logging (optional)
LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# Database failover — second Neon.tech project (optional, enables auto-failover)
# Create at https://console.neon.tech → New Project → "horas-extras-fallback"
# ---------------------------------------------------------------------------
# DATABASE_URL_FALLBACK="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ---------------------------------------------------------------------------
# Cloudflare R2 — backup storage
# Used by `npm run backup` and `npm run restore` (GitHub Actions)
# ---------------------------------------------------------------------------
# R2_ENDPOINT="https://YOUR_ACCOUNT.r2.cloudflarestorage.com"
# R2_ACCESS_KEY_ID="your-access-key-id"
# R2_SECRET_ACCESS_KEY="your-secret-access-key"
# R2_BUCKET="backups-app-hhee-entel"