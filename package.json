{
  "name": "horas-extras-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx api/index.js",
    "migrate": "tsx migrate.mjs up",
    "migrate:down": "tsx migrate.mjs down",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.backend.json --noEmit",
