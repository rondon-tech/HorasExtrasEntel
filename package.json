    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
